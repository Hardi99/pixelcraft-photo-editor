# Base de données (dev / prod) et base de test, séparées
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_editor_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photo_editor_test

# Origines autorisées par CORS, séparées par des virgules (comparaison exacte)
FRONTEND_ORIGINS=http://localhost:5173

# Production
SECRET_KEY_BASE=
FORCE_SSL=true
# Limitation de débit (Rack::Attack) : on par défaut en production, off ailleurs
RATE_LIMIT=on
# local (disque, prévoir un volume persistant) ou r2
ACTIVE_STORAGE_SERVICE=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
